# Copie este arquivo para .env e preencha os valores.

# Envio do e-mail de recuperação de senha. Sem SMTP_HOST, o link aparece no terminal do servidor.
# Para Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 e uma "senha de app" em SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Em produção, defina um segredo longo e único e habilite cookies seguros via HTTPS.
SESSION_SECRET=
COOKIE_HTTPS_ONLY=false

# reCAPTCHA v2 ("Não sou um robô") no login, cadastro e recuperação de senha.
# Crie as chaves em https://www.google.com/recaptcha/admin (tipo v2, caixa de seleção) e
# inclua "localhost" e "127.0.0.1" nos domínios. Sem as duas chaves, o reCAPTCHA fica desligado.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# E-mail de contato do responsável pelos dados, exibido na Política de Privacidade (LGPD).
# Se ficar vazio, a política usa SMTP_FROM ou SMTP_USER.
PRIVACIDADE_CONTATO=

# Supabase: banco de dados (Postgres com RLS) e armazenamento das miniaturas.
# Sem NEXO_DB_URL, o projeto usa SQLite (contas.db) e a pasta dados/miniaturas.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Conexao de administrador, usada so para migracoes e para criar o admin.
# Painel > Connect > Session pooler (porta 5432). Senha sem colchetes.
SUPABASE_DB_URL=
# Conexao do backend com o papel nexo_app (sujeito ao RLS). Ver supabase/README.md.
NEXO_DB_URL=
# Painel > Project Settings > API Keys > chave secreta (sb_secret_...). Usada no Storage.
SUPABASE_SERVICE_ROLE_KEY=
